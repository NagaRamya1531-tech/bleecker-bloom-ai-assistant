RUNPOD_TOKEN=ollama
RUNPOD_CHATBOT_URL=http://localhost:11434/v1
MODEL_NAME=llama3.1:8b
RUNPOD_EMBEDDING_URL=http://localhost:11434/v1
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_API_KEY=

# To use OpenAI instead of Ollama, replace the values above with:
# RUNPOD_TOKEN=<your OpenAI API key, sk-...>
# RUNPOD_CHATBOT_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# Keep embeddings local (free), or move them to OpenAI too:
# RUNPOD_EMBEDDING_URL=https://api.openai.com/v1
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# Optional: store conversations and orders in Supabase (Postgres).
# Leave empty to use an in-memory store (local development, lost on restart).
# Dashboard > Project Settings > API: the project URL and the secret (service_role) key.
# The secret key bypasses Row Level Security; keep it on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
